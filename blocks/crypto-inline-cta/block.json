{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "soico-cta/crypto-inline-cta",
    "version": "1.0.0",
    "title": "仮想通貨インラインCTA",
    "category": "soico-crypto-cta",
    "icon": "bitcoin",
    "description": "記事中に挿入する控えめな仮想通貨取引所インラインCTA。",
    "keywords": [
        "cta",
        "インライン",
        "仮想通貨",
        "crypto",
        "inline"
    ],
    "textdomain": "soico-securities-cta",
    "attributes": {
        "exchange": {
            "type": "string",
            "default": "gmo_coin"
        },
        "style": {
            "type": "string",
            "default": "default"
        },
        "featureText": {
            "type": "string",
            "default": ""
        },
        "customAffiliateUrl": {
            "type": "string",
            "default": ""
        },
        "customThirstyLinkId": {
            "type": "number",
            "default": 0
        }
    },
    "supports": {
        "html": false,
        "className": true
    }
}
