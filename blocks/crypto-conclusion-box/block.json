{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "soico-cta/crypto-conclusion-box",
    "version": "1.0.0",
    "title": "仮想通貨結論ボックス",
    "category": "soico-crypto-cta",
    "icon": "bitcoin",
    "description": "仮想通貨取引所をおすすめする結論ボックス。特徴リストとCTAボタン付き。",
    "keywords": ["cta", "結論", "仮想通貨", "crypto", "ビットコイン", "conclusion"],
    "textdomain": "soico-securities-cta",
    "attributes": {
        "exchange": {
            "type": "string",
            "default": "gmo_coin"
        },
        "showFeatures": {
            "type": "boolean",
            "default": true
        },
        "customTitle": {
            "type": "string",
            "default": ""
        },
        "customFeatures": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"],
        "className": true
    }
}
