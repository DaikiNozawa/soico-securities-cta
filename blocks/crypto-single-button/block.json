{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "soico-cta/crypto-single-button",
    "version": "1.0.0",
    "title": "仮想通貨CTAボタン",
    "category": "soico-crypto-cta",
    "icon": "bitcoin",
    "description": "シンプルな仮想通貨取引所CTAボタン。任意の場所に配置できます。",
    "keywords": ["cta", "ボタン", "仮想通貨", "crypto", "button"],
    "textdomain": "soico-securities-cta",
    "attributes": {
        "exchange": {
            "type": "string",
            "default": "gmo_coin"
        },
        "buttonText": {
            "type": "string",
            "default": ""
        },
        "showPR": {
            "type": "boolean",
            "default": true
        }
    },
    "supports": {
        "html": false,
        "align": ["center", "wide"],
        "className": true
    }
}
